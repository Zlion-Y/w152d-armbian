#!/bin/busybox sh
umask 022
export PATH=/bin
BB=/bin/busybox
$BB --install -s /bin
$BB mount -t proc proc /proc
$BB mount -t sysfs sysfs /sys
$BB mount -t devtmpfs devtmpfs /dev
$BB mkdir -p /run /newroot
$BB mount -t tmpfs -o mode=0755,size=16m tmpfs /run
exec >/run/w152d-bootstrap.log 2>&1
. /probe.conf
PROBE_PHASE=ARMBIAN_BOOTSTRAP
export BB PROBE_PHASE PROBE_TOKEN PORT
(
    $BB sleep "$RETURN_AFTER"
    $BB reboot -f
    $BB sleep 3
    echo b > /proc/sysrq-trigger
) &
timer=$!
while read -r module; do
    [ -n "$module" ] || continue
    $BB insmod "/lib/modules/$module" || echo "Failed module: $module"
done < /modules.order
$BB ip link set lo up
$BB ip link set eth0 up
$BB ip addr add "$PROBE_IP/24" dev eth0
$BB ip route add default via "$PROBE_GATEWAY" dev eth0
$BB setsid $BB sh /status_service.sh &
service=$!
echo 'Network bootstrap ready; extracting Armbian to a separate RAM filesystem'
if $BB mount -t tmpfs -o mode=0755,size=640m tmpfs /newroot &&
   $BB tar -xzpf /armbian-rootfs.tar.gz -C /newroot; then
    $BB cp /run/w152d-bootstrap.log /newroot/bootstrap.log
    exec >>/newroot/bootstrap.log 2>&1
    $BB rm /armbian-rootfs.tar.gz
    kill "$timer" 2>/dev/null
    kill -TERM -"$service" 2>/dev/null
    $BB sleep 1
    $BB umount /proc /sys /dev /run
    export W152D_NETWORK_READY=1
    exec $BB switch_root /newroot /init
fi
echo 'Rootfs preparation failed; preserving status until timed reboot'
while :; do $BB sleep 5; done
