#!/usr/local/bin/busybox sh
umask 022
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
BB=/usr/local/bin/busybox
$BB mount -t proc proc /proc
$BB mount -t sysfs sysfs /sys
$BB mount -t devtmpfs devtmpfs /dev
$BB mkdir -p /run /tmp /dev/pts
$BB mount -t tmpfs -o mode=0755,size=32m tmpfs /run
$BB mount -t tmpfs -o mode=1777,size=32m tmpfs /tmp
$BB mount -t devpts -o mode=0620,ptmxmode=0666 devpts /dev/pts
exec >/run/w152d-boot.log 2>&1
. /probe.conf
export BB PROBE_TOKEN PROBE_PHASE PORT
echo 'Starting Armbian ARM64 userspace in RAM with experimental BusyBox PID 1'
(
    $BB sleep "$RETURN_AFTER"
    $BB reboot -f
    $BB sleep 3
    echo b > /proc/sysrq-trigger
) &
if [ "${W152D_NETWORK_READY:-0}" != 1 ]; then
    while read -r module; do
        [ -n "$module" ] || continue
        $BB insmod "/lib/modules/$module" || echo "Failed module: $module"
    done < /modules.order
    $BB ip link set lo up
    $BB ip link set eth0 up
    $BB ip addr add "$PROBE_IP/24" dev eth0
    $BB ip route add default via "$PROBE_GATEWAY" dev eth0
fi
$BB mkdir -p /run/sshd
{
    /usr/bin/uname -m
    /usr/bin/getconf LONG_BIT
    /usr/bin/getconf GNU_LIBC_VERSION
    /usr/bin/dpkg --print-architecture
    /usr/bin/apt-get --version
    /usr/lib/systemd/systemd --version
    /usr/bin/cat /etc/os-release
} > /run/w152d-userspace.txt 2>&1
/usr/sbin/sshd -t -f /etc/ssh/sshd_config_w152d
/usr/sbin/sshd -D -e -f /etc/ssh/sshd_config_w152d >/run/w152d-sshd.log 2>&1 &
while :; do
    $BB sh /status_service.sh
    $BB sleep 1
done
