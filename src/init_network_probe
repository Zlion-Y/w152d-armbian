#!/bin/busybox sh
export PATH=/bin
BB=/bin/busybox
$BB --install -s /bin
$BB mount -t proc proc /proc
$BB mount -t sysfs sysfs /sys
$BB mount -t devtmpfs devtmpfs /dev
exec </dev/console >/dev/console 2>&1
$BB mkdir -p /run /tmp /dev/pts
$BB mount -t tmpfs -o mode=0755,size=16m tmpfs /run
$BB mount -t tmpfs -o mode=1777,size=16m tmpfs /tmp
$BB mount -t devpts devpts /dev/pts
. /probe.conf
export PROBE_TOKEN PROBE_PHASE PORT
echo "W152D network probe PID1, token $PROBE_TOKEN"
# Start return timer before driver loading, so later userspace failures are bounded.
(
    $BB sleep "$RETURN_AFTER"
    echo 'Returning to normal firmware boot'
    $BB reboot -f
    $BB sleep 3
    echo b > /proc/sysrq-trigger
) &
while read -r module; do
    [ -n "$module" ] || continue
    $BB insmod "/lib/modules/$module" || echo "Failed module: $module"
done < /modules.order
$BB ip link set lo up
$BB ip link set eth0 up
$BB ip addr add "$PROBE_IP/24" dev eth0
$BB ip route add default via "$PROBE_GATEWAY" dev eth0
echo 'Serving read-only native boot status; no shell service is exposed.'
while :; do
    $BB sh /status_service.sh
    $BB sleep 1
done
