#!/bin/busybox sh
# Phase 1: RAM-only diagnostics. No disk mounts, writes, or rootfs switch.
export PATH=/bin
BB=/bin/busybox
$BB --install -s /bin
$BB mount -t proc proc /proc
$BB mount -t sysfs sysfs /sys
$BB mount -t devtmpfs devtmpfs /dev
exec </dev/console >/dev/console 2>&1
$BB mkdir -p /dev/pts /run /tmp
$BB mount -t devpts devpts /dev/pts
$BB mount -t tmpfs -o mode=0755,size=16m tmpfs /run
$BB mount -t tmpfs -o mode=1777,size=16m tmpfs /tmp
echo 'W152D_LINUX_PROBE_V1: reached custom /init (PID 1)'
$BB uname -a
echo 'Kernel command line:'
$BB cat /proc/cmdline
echo 'Loading stock network module dependency closure:'
while read -r module; do
    [ -n "$module" ] || continue
    $BB insmod "/lib/modules/$module" || echo "Module load failed: $module"
done < /modules.order
echo 'Network interfaces:'
$BB ip link
echo 'Block devices (not mounted):'
$BB cat /proc/partitions
echo 'This probe has no Android adbd and no remote login service.'
echo 'Use the serial console; the USB root filesystem is not mounted.'
while :; do
    echo 'Starting rescue shell; exiting the shell returns here.'
    $BB sh
    $BB sleep 1
done
