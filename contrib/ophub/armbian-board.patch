+++ b/build-armbian/armbian-files/different-files/w152d/rootfs/etc/armbian-board-release.conf
@@ -0,0 +1,39 @@
+# The vendor USB recovery command sources aml_autoscript directly.
+amlogic_vendor_usb_boot="yes"
+adjust_kernel_files="yes"
+
+adjust_kernel_files_cmd() {
+    local boot_script="${tag_bootfs}/aml_autoscript"
+
+    mkimage -A arm -O linux -T script -C none -n 'Armbian USB boot' \
+        -d "${tag_bootfs}/aml_autoscript.cmd" "${boot_script}" ||
+        error_msg "Cannot compile the W152D USB boot script."
+}
+
+finalize_board_image_cmd() {
+    local initrd="initrd.img-${kernel_name}"
+    local packed="uInitrd-${kernel_name}"
+
+    # Generate a standard initramfs using the selected target distribution.
+    unshare --mount --propagation private bash -e -s -- "${tag_rootfs}" "${tag_bootfs}" "${kernel_name}" <<'BUILD_INITRAMFS' ||
+root="$1"
+boot="$2"
+release="$3"
+mkdir -p "$root"/{boot,dev,proc,sys}
+mount --bind "$boot" "$root/boot"
+mount --bind /dev "$root/dev"
+mount -t proc proc "$root/proc"
+mount -t sysfs sysfs "$root/sys"
+chroot "$root" /usr/sbin/mkinitramfs -o "/boot/initrd.img-$release" "$release"
+BUILD_INITRAMFS
+        error_msg "Cannot generate the W152D USB initramfs."
+
+    mkimage -A arm64 -O linux -T ramdisk -C none -n 'Armbian initramfs' \
+        -d "${tag_bootfs}/${initrd}" "${tag_bootfs}/${packed}" ||
+        error_msg "Cannot wrap the W152D initramfs."
+    [[ "$(stat -c %s "${tag_bootfs}/${packed}")" -le $((0x01800000)) ]] ||
+        error_msg "The W152D initramfs exceeds the vendor USB load window."
+    cp -f "${tag_bootfs}/${packed}" "${tag_bootfs}/uInitrd"
+    systemctl --root="${tag_rootfs}" enable armbian-front-panel.service ||
+        error_msg "Cannot enable the front-panel LED service."
+}
