+static int w152d_hs200_window(u32 good, unsigned int taps)
+{
+	unsigned int start, len, best_start = 0, best_len = 0;
+
+	if (!taps || taps > 32)
+		return -EINVAL;
+	for (start = 0; start < taps; start++) {
+		for (len = 0; len < taps; len++)
+			if (!(good & BIT((start + len) % taps)))
+				break;
+		if (len > best_len) {
+			best_start = start;
+			best_len = len;
+		}
+	}
+	return best_len >= 2 ? (int)((best_start + best_len / 2) % taps) : -EIO;
+}
