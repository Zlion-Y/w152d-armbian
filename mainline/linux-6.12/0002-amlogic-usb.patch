+
+#define	CRG_U3DC_CMD_CTRL_TYPE_SHIFT		(4)
+#define	CRG_U3DC_CMD_CTRL_TYPE_MASK	\
+		(0xf << CRG_U3DC_CMD_CTRL_TYPE_SHIFT)
