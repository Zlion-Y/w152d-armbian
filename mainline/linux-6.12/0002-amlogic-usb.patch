+static inline u32 index2DCI(u16 index)
+{
+	if (index == 0)
+		return 0;
+
+	return (index & USB_ENDPOINT_NUMBER_MASK) * 2 + ((index &
+				USB_DIR_IN) ? 0 : 1);
+}
