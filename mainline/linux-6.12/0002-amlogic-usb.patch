+bool is_pointer_less_than(struct transfer_trb_s *a,
+	struct transfer_trb_s *b, struct crg_udc_ep *udc_ep)
+{
+	if (b > a && (udc_ep->enq_pt >= b || udc_ep->enq_pt < a))
+		return true;
+	if (b < a && (udc_ep->enq_pt >= b && udc_ep->enq_pt < a))
+		return true;
+	return false;
+}
