+static int init_ep_info(struct crg_gadget_dev *crg_udc)
+{
+	int i;
+
+	/*udc_ep[0] is reserved, */
+	crg_ep_struct_setup(crg_udc, 0, NULL);
+
+	for (i = 1; i < CRG_NUM_EP_CX / 2; i++) {
+		char name[14];
+
+		sprintf(name, "ep%din", i);
+		crg_ep_struct_setup(crg_udc, i * 2, name);
