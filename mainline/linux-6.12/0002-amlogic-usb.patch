+void aml_xhci_free_command(struct aml_xhci_hcd *xhci,
+		struct aml_xhci_command *command)
+{
+	aml_xhci_free_container_ctx(xhci,
+			command->in_ctx);
+	kfree(command->completion);
+	kfree(command);
+}
