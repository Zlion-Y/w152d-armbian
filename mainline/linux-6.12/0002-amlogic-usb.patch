+aml_xhci_debugfs_create_endpoint(struct aml_xhci_hcd *xhci,
+			     struct aml_xhci_virt_device *virt_dev,
+			     int ep_index) { }
+static inline void
+aml_xhci_debugfs_remove_endpoint(struct aml_xhci_hcd *xhci,
+			     struct aml_xhci_virt_device *virt_dev,
+			     int ep_index) { }
+static inline void
+aml_xhci_debugfs_create_stream_files(struct aml_xhci_hcd *xhci,
+				 struct aml_xhci_virt_device *virt_dev,
+				 int ep_index) { }
