+static void xhci_handle_cmd_reset_dev(struct aml_xhci_hcd *xhci, int slot_id)
+{
+	struct aml_xhci_virt_device *vdev;
+	struct aml_xhci_slot_ctx *slot_ctx;
+
+	vdev = xhci->devs[slot_id];
+	if (!vdev) {
+		aml_xhci_warn(xhci, "Reset device command completion for disabled slot %u\n",
+			  slot_id);
+		return;
