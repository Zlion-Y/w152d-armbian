+	slot_ctx = aml_xhci_get_slot_ctx(xhci, vdev->out_ctx);
+	trace_aml_xhci_handle_cmd_reset_dev(slot_ctx);
+
+	aml_xhci_dbg(xhci, "Completed reset device command.\n");
+}
