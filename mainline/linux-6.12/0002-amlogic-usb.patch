diff --git a/drivers/usb/usbc2phy/phy-aml-new-usb3-c2.c b/drivers/usb/usbc2phy/phy-aml-new-usb3-c2.c
new file mode 100644
index 000000000..fa935969d
--- /dev/null
+++ b/drivers/usb/usbc2phy/phy-aml-new-usb3-c2.c
@@ -0,0 +1,643 @@
