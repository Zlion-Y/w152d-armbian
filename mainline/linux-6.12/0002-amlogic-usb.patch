index 000000000..261bc9c60
--- /dev/null
+++ b/drivers/usb/crgdrdphy/phy-aml-crg-drd-otg.c
@@ -0,0 +1,545 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+/*
