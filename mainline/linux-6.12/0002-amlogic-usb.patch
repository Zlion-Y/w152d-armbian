+static void xhci_handle_cmd_nec_get_fw(struct aml_xhci_hcd *xhci,
+		struct aml_xhci_event_cmd *event)
+{
+	if (!(xhci->quirks & XHCI_NEC_HOST)) {
+		aml_xhci_warn(xhci, "WARN NEC_GET_FW command on non-NEC host\n");
+		return;
