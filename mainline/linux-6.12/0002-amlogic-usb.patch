+{
+	struct amlogic_usb_v2 *phy = phy_to_amlusb(x);
+
+	if (phy->phy.flags == AML_USB3_PHY_ENABLE) {
+		clk_disable_unprepare(phy->clk);
+		clk_disable_unprepare(phy->gate1_clk);
+		clk_disable_unprepare(phy->gate0_clk);
+	}
