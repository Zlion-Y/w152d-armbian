diff --git a/drivers/net/mdio/mdio-mux-meson-g12a.c b/drivers/net/mdio/mdio-mux-meson-g12a.c
index 754b0f2cf..271190d1f 100644
--- a/drivers/net/mdio/mdio-mux-meson-g12a.c
+++ b/drivers/net/mdio/mdio-mux-meson-g12a.c
@@ -12,6 +12,7 @@
 #include <linux/iopoll.h>
 #include <linux/mdio-mux.h>
 #include <linux/module.h>
+#include <linux/of.h>
 #include <linux/phy.h>
 #include <linux/platform_device.h>
 
@@ -56,6 +57,7 @@ struct g12a_mdio_mux {
 	void __iomem *regs;
 	void *mux_handle;
 	struct clk *pll;
+	void __iomem *w152d_trim;
 };
 
 struct g12a_ephy_pll {
@@ -162,6 +164,24 @@ static int g12a_enable_internal_mdio(struct g12a_mdio_mux *priv)
 	/* Initialize ephy control */
 	writel(EPHY_G12A_ID, priv->regs + ETH_PHY_CNTL0);
 
+	if (priv->w152d_trim) {
+		u32 fuse = readl(priv->w152d_trim);
+		u32 analog = 0xa9860000;
+
+		/* The stock enet_type=10 internal PHY sequence. */
+		writel(0x74043, priv->regs + ETH_PHY_CNTL1);
+		mdelay(10);
+		writel(0x260, priv->regs + ETH_PHY_CNTL2);
+		if (fuse & BIT(24))
+			analog = 0x09060000 | (fuse & GENMASK(23, 20)) |
+				 (FIELD_GET(GENMASK(19, 16), fuse) << 28);
+		writel(analog, priv->regs + ETH_PLL_CTL3);
+		writel(0x4001, priv->regs + ETH_PLL_CTL6);
+		writel(0x10800000, priv->regs + ETH_PLL_CTL5);
+		writel(0x3623, priv->regs + ETH_PLL_CTL7);
+		return 0;
+	}
+
 	/* Make sure we get a 0 -> 1 transition on the enable bit */
 	value = FIELD_PREP(PHY_CNTL1_ST_MODE, 3) |
 		FIELD_PREP(PHY_CNTL1_ST_PHYADD, EPHY_DFLT_ADD) |
@@ -314,6 +334,12 @@ static int g12a_mdio_mux_probe(struct platform_device *pdev)
 
 	platform_set_drvdata(pdev, priv);
 
+	if (of_machine_is_compatible("amlogic,gxlx4-s905l4-w150d")) {
+		priv->w152d_trim = devm_ioremap(dev, 0xfe010330, sizeof(u32));
+		if (!priv->w152d_trim)
+			return -ENOMEM;
+	}
+
 	priv->regs = devm_platform_ioremap_resource(pdev, 0);
 	if (IS_ERR(priv->regs))
 		return PTR_ERR(priv->regs);
diff --git a/drivers/net/phy/meson-gxl.c b/drivers/net/phy/meson-gxl.c
index bb9b33b6b..563bea890 100644
--- a/drivers/net/phy/meson-gxl.c
+++ b/drivers/net/phy/meson-gxl.c
@@ -11,6 +11,7 @@
 #include <linux/mii.h>
 #include <linux/ethtool.h>
 #include <linux/phy.h>
+#include <linux/of.h>
 #include <linux/netdevice.h>
 #include <linux/bitfield.h>
 #include <linux/smscphy.h>
@@ -184,6 +185,31 @@ static int meson_gxl_read_status(struct phy_device *phydev)
 	return genphy_read_status(phydev);
 }
 
+static int w152d_g12a_phy_config_init(struct phy_device *phydev)
+{
+	/* PHY test-register sequence from the stock W152D enet_type=10 path. */
+	static const struct { u8 reg; u16 value; } sequence[] = {
+		{ 20, 0 }, { 20, 0x400 }, { 20, 0 }, { 20, 0x400 },
+		{ 23, 11 }, { 20, 0x4418 },
+		{ 20, 0 }, { 20, 0x400 }, { 20, 0 }, { 20, 0x400 },
+		{ 23, 0x1000 }, { 20, 0x4413 },
+		{ 20, 0 }, { 20, 0x400 }, { 20, 0 }, { 20, 0x400 },
+		{ 23, 0x8406 }, { 20, 0x4416 },
+		{ 20, 0 }, { 20, 0x400 }, { 20, 0 }, { 20, 0x400 },
+		{ 23, 0x2408 }, { 20, 0x4415 }, { 20, 0 },
+	};
+	int i, ret;
+
+	if (!of_machine_is_compatible("amlogic,gxlx4-s905l4-w150d"))
+		return smsc_phy_config_init(phydev);
+	for (i = 0; i < ARRAY_SIZE(sequence); i++) {
+		ret = phy_write(phydev, sequence[i].reg, sequence[i].value);
+		if (ret < 0)
+			return ret;
+	}
+	return phy_restart_aneg(phydev);
+}
+
 static struct phy_driver meson_gxl_phy[] = {
 	{
 		PHY_ID_MATCH_EXACT(0x01814400),
@@ -205,7 +231,7 @@ static struct phy_driver meson_gxl_phy[] = {
 		/* PHY_BASIC_FEATURES */
 		.flags		= PHY_IS_INTERNAL,
 		.probe		= smsc_phy_probe,
-		.config_init	= smsc_phy_config_init,
+		.config_init	= w152d_g12a_phy_config_init,
 		.soft_reset     = genphy_soft_reset,
 		.read_status	= lan87xx_read_status,
 		.config_intr	= smsc_phy_config_intr,
