#!/bin/busybox sh
# USB FAT volume -> ext4 loop image -> persistent Armbian. No eMMC mounts.
umask 022
export PATH=/bin
BB=/bin/busybox
$BB --install -s /bin
$BB mount -t proc proc /proc
$BB mount -t sysfs sysfs /sys
$BB mount -t devtmpfs devtmpfs /dev
$BB mkdir -p /run /usb /newroot
$BB mount -t tmpfs -o mode=0755,size=16m tmpfs /run
exec >/run/w152d-bootstrap.log 2>&1
. /probe.conf
PROBE_PHASE=ARMBIAN_USB_BOOTSTRAP
export BB PROBE_PHASE PROBE_TOKEN PORT
echo 'W152D direct USB bootstrap started'
USB_DIR=w152d
for arg in $($BB cat /proc/cmdline); do
    case "$arg" in w152d.usb_dir=*) USB_DIR=${arg#w152d.usb_dir=};; esac
done
case "$USB_DIR" in ''|*[!a-zA-Z0-9_-]*) echo 'Invalid USB directory'; exit 1;; esac
export W152D_USB_DIR=$USB_DIR
while read -r module; do
    [ -n "$module" ] || continue
    $BB insmod "/lib/modules/$module" || echo "Module load failed: $module"
done < /modules.order
$BB ip link set lo up
# The public bootstrap needs only built-in USB/ext4 support. Networking starts
# in the persistent rootfs after per-device files have been provisioned.
found=
try=0
while [ "$try" -lt 30 ]; do
    try=$((try+1))
    echo "USB_SCAN=$try"
    for dev in /dev/sda1 /dev/sdb1 /dev/sdc1 /dev/sdd1; do
        [ -b "$dev" ] || continue
        if ! $BB mount -t vfat -o rw,noatime "$dev" /usb; then continue; fi
        if [ "$($BB tr -d '\r\n' < /usb/$USB_DIR/USB_ID 2>/dev/null)" != W152D_ARMBIAN_USB_DIRECT_V1 ]; then
            $BB umount /usb
            continue
        fi
        if $BB losetup /dev/loop15 /usb/$USB_DIR/rootfs.ext4; then
            if $BB mount -t ext4 -o rw,noatime /dev/loop15 /newroot; then
                if [ -x /newroot/init ] && [ -x /newroot/usr/sbin/sshd ] && [ -f /newroot/etc/w152d-udisk ]; then
                    found=$dev
                    break
                fi
                $BB umount /newroot
            fi
            $BB losetup -d /dev/loop15
        fi
        $BB umount /usb
    done
    [ -n "$found" ] && break
    $BB sleep 3
done
if [ -z "$found" ]; then
    echo 'USB_ROOTFS_FAILED: remove USB before the next power-on to return to Android.'
    PROBE_PHASE=ARMBIAN_USB_ROOTFS_FAILED
    export PROBE_PHASE
    ($BB sleep 120; $BB reboot -f) &
    while :; do $BB sh /status_service.sh; $BB sleep 2; done
fi
echo "USB_ROOTFS_FOUND=$found loop=/dev/loop15"
echo "USB_ROOTFS_FOUND=$found loop=/dev/loop15" > /dev/console
$BB mkdir -p /newroot/media/w152d-usb /newroot/run /newroot/proc /newroot/sys /newroot/dev
$BB mount --move /usb /newroot/media/w152d-usb || exit 1
$BB mount --move /proc /newroot/proc || exit 1
$BB mount --move /sys /newroot/sys || exit 1
$BB mount --move /dev /newroot/dev || exit 1
$BB mount --move /run /newroot/run || exit 1
export W152D_NETWORK_READY=0
case " $($BB cat /newroot/proc/cmdline) " in
    *' w152d.ttl_shell=1 '*)
        $BB chroot /newroot /usr/local/bin/busybox sh -i </newroot/dev/console >/newroot/dev/console 2>&1 &
        ;;
esac
exec $BB switch_root /newroot /init
