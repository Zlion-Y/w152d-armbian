#!/bin/busybox sh
set -eu
export PATH=/bin
/bin/busybox --install -s /bin
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev

load() {
    if ! timeout 15 insmod "/drivers/$1.ko"; then
        printf '<4>W152D: could not load %s\n' "$1" >/dev/kmsg
        return 1
    fi
}

if [ -L /sys/bus/platform/devices/fe35a000.usb3-phy/driver ] &&
   [ -L /sys/bus/platform/devices/fe348000.usb2-hub/driver ]; then
    load xhci-plat-hcd || :
else
    echo '<3>W152D: USB PHY driver binding incomplete' >/dev/kmsg
fi

if load smsc && load meson-gxl; then
    load mdio-mux-meson-g12a || :
fi

exec /bin/w152d-usb-root
