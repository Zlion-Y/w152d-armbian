#!/bin/busybox sh
set -eu
export PATH=/bin

failed() {
    echo '<3>W152D: USB root handoff failed; restarting' >/dev/kmsg
    sync
    reboot -f
}
trap failed EXIT

find_usb_root() {
    for part in /sys/class/block/sd*1; do
        node=/dev/${part##*/}
        [ -b "$node" ] || continue
        parent=$(readlink -f "$part")
        while [ -n "$parent" ] && [ ! -r "$parent/idVendor" ]; do
            parent=${parent%/*}
        done
        [ -n "$parent" ] && [ "$(cat "$parent/idVendor"):$(cat "$parent/idProduct")" = 0781:55a3 ] || continue
        mount -t vfat -o rw,noatime "$node" /usb || continue
        if [ -r /usb/w152d/USB_ID ] &&
           [ "$(tr -d '\r\n' </usb/w152d/USB_ID)" = W152D_ARMBIAN_USB_MAINLINE_V1 ] &&
           [ -s /usb/w152d/rootfs.ext4 ]; then
            return 0
        fi
        umount /usb || exit 1
    done
    return 1
}

mkdir -p /usb /newroot /run
for n in $(seq 1 15); do
    if find_usb_root; then
        break
    fi
    sleep 1
done
mountpoint -q /usb
loop_device=$(losetup -f)
losetup "$loop_device" /usb/w152d/rootfs.ext4
mount -t ext4 -o rw,noatime "$loop_device" /newroot
[ -x /newroot/init ] && [ -x /newroot/usr/sbin/sshd ]
[ "$(cat /newroot/etc/w152d-udisk)" = W152D_ARMBIAN_USB_MAINLINE_V1 ]

mount -t tmpfs -o mode=0755,size=32m tmpfs /run
mkdir -p /newroot/media/w152d-usb
mount --move /usb /newroot/media/w152d-usb
for mp in proc sys dev run; do
    mkdir -p "/newroot/$mp"
    mount --move "/$mp" "/newroot/$mp"
done
trap - EXIT
exec switch_root /newroot /init
